{
	"compilerOptions": {
		"rootDir": "./src",

		"module": "nodenext",
		"target": "esnext",
		"lib": ["esnext"],
		"types": ["node"],
		"outDir": "./dist",
		"sourceMap": true,

		"paths": {
			"@middleware/*": ["./src/admin/middlewares/*"],
			"@domain/*": ["./src/admin/domain/*"],
			"@controller/*": ["./src/admin/controllers/*"],
			"@services/*": ["./src/admin/services/*"],
			"@repo/*": ["./src/admin/repos/*"],
			"@utils/*": ["./src/admin/utils/*"],
			"@zod/*": ["./src/admin/zod/*"],
			"@routes/*": ["./src/admin/routes/*"],
			"@query/*": ["./src/admin/queries/*"],
			"@definitions/*": ["./src/admin/definitions/*"],
			"@src/*": ["./src/*"],
			"@client/*": ["./src/client/*"],
			"@emails/*": ["./emails/*"]
		},

		"exactOptionalPropertyTypes": true,

		"noImplicitReturns": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,

		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"skipLibCheck": true,

		"allowJs": true
	},

	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"src/**/*.test.ts",
		"src/admin/controllers/learn-controller.ts",
		"src/admin/queries/learn-query.ts"
	]
}
