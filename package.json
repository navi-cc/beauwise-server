{
	"name": "beauwise-server",
	"type": "module",
	"scripts": {
		"build": "tsc && tsc-alias",
		"build:watch": "tsc --watch",
		"alias:watch": "tsc-alias --watch",
		"load:env": "cross-env NODE_ENV=development FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080",
		"start:firebase": "npm run load:env -- firebase emulators:start --import=./firebase.emulator.data --only auth,functions,firestore",
		"dev": "npm run build && concurrently \"npm run build:watch\" \"npm run alias:watch\" \"npm run start:firebase\"",
		"lint": "eslint .",
		"shell": "firebase functions:shell",
		"start": "npm run shell",
		"deploy": "firebase deploy --only functions",
		"logs": "firebase functions:log",
		"test": "npm run load:env vitest",
		"seed": "node ./src/admin/seed.js",
		"seed:local": "npm run load:env node ./src/admin/seed.js"
	},
	"engines": {
		"node": "22"
	},
	"main": "./dist/index.js",
	"dependencies": {
		"@google-cloud/vision": "^5.3.7",
		"@google/genai": "^2.9.0",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"firebase-admin": "^13.10.0",
		"firebase-functions": "^7.2.5",
		"typesense": "^3.0.6",
		"zod": "^4.4.3",
		"zod-to-json-schema": "^3.25.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@firebase/rules-unit-testing": "^5.0.1",
		"@types/node": "^25.9.1",
		"@types/supertest": "^7.2.0",
		"concurrently": "^10.0.3",
		"cross-env": "^10.1.0",
		"eslint": "^10.5.0",
		"firebase-functions-test": "^3.5.0",
		"globals": "^17.6.0",
		"jiti": "^2.7.0",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.17",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1",
		"vitest": "^4.1.8"
	}
}
